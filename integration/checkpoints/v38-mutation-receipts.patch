diff --git a/app/mutation-receipt.ts b/app/mutation-receipt.ts
new file mode 100644
index 0000000..03362d5
--- /dev/null
+++ b/app/mutation-receipt.ts
@@ -0,0 +1,39 @@
+export type StoredMutationReceipt = {
+  operationKind: string;
+  responseJson: string;
+  statusCode: number;
+};
+
+export function normalizeOperationId(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const normalized = value.trim();
+  return /^[a-zA-Z0-9_-]{8,80}$/.test(normalized) ? normalized : null;
+}
+
+export function mutationReceiptKey(userEmail: string, operationId: string) {
+  return `${userEmail}\n${operationId}`;
+}
+
+export function replayMutationReceipt(
+  receipt: StoredMutationReceipt,
+  expectedKind: string,
+) {
+  if (receipt.operationKind !== expectedKind) {
+    return Response.json(
+      {
+        error:
+          "This operation identifier was already used for a different MatchLab action.",
+      },
+      { status: 409 },
+    );
+  }
+
+  return new Response(receipt.responseJson, {
+    status: receipt.statusCode,
+    headers: {
+      "Cache-Control": "no-store",
+      "Content-Type": "application/json",
+      "X-MatchLab-Replayed": "true",
+    },
+  });
+}
