diff --git a/app/repair-language-policy.ts b/app/repair-language-policy.ts
new file mode 100644
index 0000000..ddb0a5d
--- /dev/null
+++ b/app/repair-language-policy.ts
@@ -0,0 +1,114 @@
+export const repairLanguagePrompts = [
+  "After tension, what helps you believe the relationship is still safe?",
+  "If someone needs space, what makes that space feel caring rather than distancing?",
+  "What matters most when you reconnect?",
+] as const;
+
+export const repairLanguageChoices = [
+  [
+    "A quick ‘we’re okay’ before taking space",
+    "Talking until we find the full resolution",
+    "Physical reassurance before words",
+  ],
+  [
+    "A clear time to come back together",
+    "A warm message while we cool down",
+    "Freedom to return when ready",
+  ],
+  [
+    "Knowing we understood each other",
+    "Hearing a genuine apology",
+    "Feeling like we are a team again",
+  ],
+] as const;
+
+export type RepairLanguageResult = {
+  title: string;
+  learning: string;
+  spectrum: {
+    reassurance: number;
+    resolution: number;
+    space: number;
+  };
+};
+
+export function validateRepairLanguageAnswers(value: unknown) {
+  if (!Array.isArray(value) || value.length !== repairLanguagePrompts.length) {
+    return {
+      ok: false as const,
+      error: "Complete all three Repair Language moments before saving a result.",
+    };
+  }
+
+  const answers = value.map((answer) =>
+    typeof answer === "string" ? answer.trim() : "",
+  );
+  const valid = answers.every((answer, index) =>
+    repairLanguageChoices[index].some((choice) => choice === answer),
+  );
+  if (!valid) {
+    return {
+      ok: false as const,
+      error: "Choose one of the offered answers for each Repair Language moment.",
+    };
+  }
+
+  return { ok: true as const, answers };
+}
+
+export function getRepairLanguageResult(
+  answers: readonly string[],
+): RepairLanguageResult {
+  const scores = { reassurance: 0, resolution: 0, space: 0 };
+
+  for (const answer of answers) {
+    if (
+      answer.includes("we’re okay") ||
+      answer.includes("Physical reassurance") ||
+      answer.includes("warm message") ||
+      answer.includes("genuine apology") ||
+      answer.includes("team again")
+    ) {
+      scores.reassurance += 1;
+    } else if (
+      answer.includes("full resolution") ||
+      answer.includes("understood each other")
+    ) {
+      scores.resolution += 1;
+    } else {
+      scores.space += 1;
+    }
+  }
+
+  const strongest = (Object.entries(scores) as Array<
+    [keyof typeof scores, number]
+  >).sort((a, b) => b[1] - a[1])[0]?.[0] ?? "reassurance";
+  const reads = {
+    reassurance: {
+      title: "Reassurance before resolution",
+      learning:
+        "After conflict, I need a clear signal that we are still on the same team before either of us takes space.",
+    },
+    resolution: {
+      title: "Understanding creates safety",
+      learning:
+        "After conflict, I feel safest when we stay with the conversation long enough to understand what happened—even if agreement takes longer.",
+    },
+    space: {
+      title: "Space needs a clear return",
+      learning:
+        "After conflict, space can feel caring to me when we name how and when we will come back together.",
+    },
+  };
+  const percentage = (score: number) =>
+    answers.length ? Math.round(34 + (score / answers.length) * 66) : 34;
+
+  return {
+    ...reads[strongest],
+    spectrum: {
+      reassurance: percentage(scores.reassurance),
+      resolution: percentage(scores.resolution),
+      space: percentage(scores.space),
+    },
+  };
+}
