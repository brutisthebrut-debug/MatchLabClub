new file mode 100644
index 0000000..c706c09
--- /dev/null
+++ b/app/api/play/repair-language/route.ts
@@ -0,0 +1,153 @@
+import { and, eq } from "drizzle-orm";
+import { getDb } from "../../../../db";
+import {
+  journeyStates,
+  matchingCandidacies,
+  mutationReceipts,
+} from "../../../../db/schema";
+import { accountBindingConflict, accountBindingMatches } from "../../../account-binding";
+import { getChatGPTUser } from "../../../chatgpt-auth";
+import {
+  mutationReceiptKey,
+  normalizeOperationId,
+  replayMutationReceipt,
+} from "../../../mutation-receipt";
+import {
+  getRepairLanguageResult,
+  validateRepairLanguageAnswers,
+} from "../../../repair-language-policy";
+import { readBoundedJsonObject } from "../../../request-policy";
+
+export const dynamic = "force-dynamic";
+
+export async function POST(request: Request) {
+  const user = await getChatGPTUser();
+  if (!user) {
+    return Response.json(
+      { error: "Sign in to save a Play result." },
+      { status: 401 },
+    );
+  }
+
+  const parsed = await readBoundedJsonObject(request, 8 * 1024);
+  if (!parsed.ok) return parsed.response;
+  const payload = parsed.value as {
+    answers?: unknown;
+    revision?: number | null;
+    accountEmail?: string;
+    operationId?: string;
+  };
+  if (!accountBindingMatches(payload.accountEmail, user.email)) {
+    return accountBindingConflict();
+  }
+  const operationId = normalizeOperationId(payload.operationId);
+  if (!operationId) {
+    return Response.json(
+      { error: "A valid operation identifier is required to save safely." },
+      { status: 400 },
+    );
+  }
+
+  const db = getDb();
+  const receiptKey = mutationReceiptKey(user.email, operationId);
+  const [existingReceipt] = await db
+    .select()
+    .from(mutationReceipts)
+    .where(eq(mutationReceipts.receiptKey, receiptKey))
+    .limit(1);
+  if (existingReceipt) {
+    return replayMutationReceipt(existingReceipt, "repair-language-complete");
+  }
+
+  const validated = validateRepairLanguageAnswers(payload.answers);
+  if (!validated.ok) {
+    return Response.json({ error: validated.error }, { status: 400 });
+  }
+  const [journey] = await db
+    .select()
+    .from(journeyStates)
+    .where(eq(journeyStates.userEmail, user.email))
+    .limit(1);
+  if (!journey) {
+    return Response.json(
+      { error: "Open your saved MatchLab before completing Play." },
+      { status: 409 },
+    );
+  }
+  if (!Number.isInteger(payload.revision) || payload.revision !== journey.revision) {
+    return Response.json(
+      {
+        error:
+          "Your MatchLab changed in another save. Reload the latest version before trying again.",
+        conflict: true,
+      },
+      { status: 409 },
+    );
+  }
+
+  const result = getRepairLanguageResult(validated.answers);
+  const now = new Date().toISOString();
+  const revision = journey.revision + 1;
+  const saveJourney = db
+    .update(journeyStates)
+    .set({
+      repairAnswers: JSON.stringify(validated.answers),
+      repairCompleted: true,
+      mirrorLearning: result.learning,
+      mirrorRejected: false,
+      mirrorConfirmed: false,
+      mirrorMatchingUse: false,
+      matchingPilotJoined: false,
+      stage: Math.max(journey.stage, 3),
+      revision,
+      updatedAt: now,
+    })
+    .where(
+      and(
+        eq(journeyStates.userEmail, user.email),
+        eq(journeyStates.revision, journey.revision),
+      ),
+    )
+    .returning();
+  const [savedRows] = await db.batch([
+    saveJourney,
+    db
+      .update(matchingCandidacies)
+      .set({
+        status: "paused",
+        consentRevision: revision,
+        pausedAt: now,
+        updatedAt: now,
+      })
+      .where(eq(matchingCandidacies.userEmail, user.email)),
+  ]);
+  if (!savedRows.length) {
+    return Response.json(
+      {
+        error:
+          "Your MatchLab changed in another save. Reload the latest version before trying again.",
+        conflict: true,
+      },
+      { status: 409 },
+    );
+  }
+
+  const responseBody = {
+    state: savedRows[0],
+    result: { ...result, answers: validated.answers },
+  };
+  await db
+    .insert(mutationReceipts)
+    .values({
+      receiptKey,
+      userEmail: user.email,
+      operationId,
+      operationKind: "repair-language-complete",
+      responseJson: JSON.stringify(responseBody),
+      statusCode: 200,
+      createdAt: now,
+    })
+    .onConflictDoNothing();
+
+  return Response.json(responseBody);
+}
