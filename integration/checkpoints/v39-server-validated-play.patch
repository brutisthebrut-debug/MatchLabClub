+async function loadRepairLanguagePolicy() {
+  const source = await readFile(
+    new URL("../app/repair-language-policy.ts", import.meta.url),
+    "utf8",
+  );
+  const compiled = ts.transpileModule(source, {
+    compilerOptions: {
+      module: ts.ModuleKind.ESNext,
+      target: ts.ScriptTarget.ES2022,
+    },
+  }).outputText;
+
+  return import(
+    `data:text/javascript,${encodeURIComponent(compiled)}#${Date.now()}`
+  );
+}
+
+test("validates Repair Language evidence on the server before progress", async () => {
+  const policy = await loadRepairLanguagePolicy();
+  const validAnswers = policy.repairLanguageChoices.map(
