diff --git a/app/pilot-notice-policy.ts b/app/pilot-notice-policy.ts
new file mode 100644
index 0000000..d602baa
--- /dev/null
+++ b/app/pilot-notice-policy.ts
@@ -0,0 +1,27 @@
+import { PILOT_NOTICE_VERSION } from "./matching-policy";
+
+export { PILOT_NOTICE_VERSION };
+
+export const pilotNoticePoints = [
+  "This is a controlled Austin beta with intentionally limited availability. MatchLab does not guarantee an introduction or a timeline.",
+  "Submitting a candidacy starts founder review. It does not activate matching or place me in a live pool.",
+  "Matching may use only my structured candidacy and the specific Mirror learning I separately confirmed and approved.",
+  "MatchLab and Echo are not emergency, clinical, or wellness services.",
+] as const;
+
+export function validatePilotNoticeAcceptance(input: {
+  pilotNoticeAccepted?: unknown;
+  pilotNoticeVersion?: unknown;
+}) {
+  if (
+    input.pilotNoticeAccepted !== true ||
+    input.pilotNoticeVersion !== PILOT_NOTICE_VERSION
+  ) {
+    return {
+      ok: false as const,
+      error:
+        "Review and accept the current controlled-pilot notice before submitting candidacy.",
+    };
+  }
+  return { ok: true as const, version: PILOT_NOTICE_VERSION };
+}
