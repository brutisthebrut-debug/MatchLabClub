   revision: number;
 };
 
+export type CandidacyConsentStatus = "active" | "pending_review" | "paused";
+
 export function normalizeMatchingDecision(input: MatchingDecisionInput) {
   const mirrorRejected = Boolean(input.mirrorRejected);
   const mirrorConfirmed =
@@ -89,3 +91,32 @@ export function isCandidacyConsentCurrent(
       journey.matchingPilotJoined,
   );
 }
+
+export function isCandidacyConsentEligible(
+  candidacy: SavedCandidacyConsent | null | undefined,
+  journey: SavedJourneyConsent | null | undefined,
+) {
+  return Boolean(
+    candidacy &&
+      journey &&
+      candidacy.consentRevision === journey.revision &&
+      candidacy.approvedLearning === journey.mirrorLearning &&
+      !journey.mirrorRejected &&
+      journey.mirrorConfirmed &&
+      journey.mirrorMatchingUse,
+  );
+}
+
+export function getCandidacyConsentStatus(
+  candidacy: SavedCandidacyConsent | null | undefined,
+  journey: SavedJourneyConsent | null | undefined,
+): CandidacyConsentStatus {
+  if (isCandidacyConsentCurrent(candidacy, journey)) return "active";
+  if (
+    candidacy?.status === "pending_review" &&
+    isCandidacyConsentEligible(candidacy, journey)
+  ) {
+    return "pending_review";
+  }
+  return "paused";
+}
