+class RequestOutcomeUnknownError extends Error {
+  constructor() {
+    super(
+      "The connection ended before MatchLab could confirm what saved. Check the latest saved version before trying again.",
+    );
+    this.name = "RequestOutcomeUnknownError";
+  }
+}
+
+async function fetchWithDeadline(
+  input: RequestInfo | URL,
+  init?: RequestInit,
+  timeoutMs = 10_000,
+) {
+  const controller = new AbortController();
+  const timeout = window.setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    return await fetch(input, { ...init, signal: controller.signal });
+  } catch (error) {
+    if (controller.signal.aborted) {
+      throw new RequestOutcomeUnknownError();
+    }
+    throw error;
+  } finally {
+    window.clearTimeout(timeout);
+  }
+}
