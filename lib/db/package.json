{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "ensure-extensions": "tsx ./src/ensure-extensions.ts",
    "push": "pnpm run ensure-extensions && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "pnpm run ensure-extensions && drizzle-kit push --force --config ./drizzle.config.ts",
    "check-schema-drift": "tsx ./scripts/check-schema-drift.ts",
    "migrate": "pnpm run ensure-extensions && tsx ./src/migrate.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:"
  }
}
