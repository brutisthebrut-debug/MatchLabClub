# MatchLab pre-production release environment
# Copy into the deployment provider. Never commit real values.
#
# Verify before deployment:
#   pnpm run validate:release-env
#
# The validator reports variable names only and never prints configured values.

# Required API runtime
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
PORT=8080
NODE_ENV=production

# Authentication
# ISSUER_URL must be the controlled non-Replit OIDC issuer.
ISSUER_URL=https://identity.matchlab.club
# Compatibility name: the current runtime reads REPL_ID as its OIDC client id.
# Rename the runtime variable to OIDC_CLIENT_ID in the remaining auth migration.
REPL_ID=matchlab-web-client

# Trusted browser origins
# Compatibility name: the current runtime reads REPLIT_DOMAINS.
# Enter hostnames only, without https:// or paths.
# Rename the runtime variable to ALLOWED_ORIGINS in the remaining hosting migration.
REPLIT_DOMAINS=app.matchlab.club,preview.matchlab.club

# Founder bootstrap is optional and server-only.
FOUNDER_EMAILS=

# AI providers are optional before release; deterministic fallback behavior remains.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability is optional for preview and required before public launch.
SENTRY_DSN_API=
VITE_SENTRY_DSN=

# Stripe stays fail-closed. Do not add products until the test-mode suite and
# founder/legal gates are complete. The validator rejects any non-empty value.
BILLING_LIVE_PRODUCTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SIGNAL_AUDIT=
STRIPE_PRICE_DATING_RESET=
STRIPE_PRICE_WINGMAN=

# Storage and outbound providers remain optional until their feature gates open.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
